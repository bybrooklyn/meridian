{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meridian renderer path evaluations",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const":"0.5" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "research_gate",
          "candidate",
          "status",
          "preregistered_thresholds",
          "workload_results",
          "maintenance_review"
        ],
        "properties": {
          "id": { "type": "string" },
          "research_gate": { "enum": ["RG-PEN-001", "RG-UI-001"] },
          "candidate": { "type": "string" },
          "status": { "enum": ["Planned", "Running", "Rejected", "Promoted", "Decided", "Inconclusive"] },
          "preregistered_thresholds": { "type": "object" },
          "workload_results": { "type": "array" },
          "maintenance_review": { "type": "string" },
          "work_package": { "type": "string", "pattern": "^WP-[A-Z]+-[0-9]{3}$" },
          "adr": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
          "decision_limits": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
