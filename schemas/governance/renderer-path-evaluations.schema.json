{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Penumbra renderer path evaluations",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const":"0.5" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "research_gate",
          "candidate",
          "status",
          "preregistered_thresholds",
          "workload_results",
          "maintenance_review"
        ],
        "properties": {
          "id": { "type": "string" },
          "research_gate": { "const": "RG-PEN-001" },
          "candidate": { "type": "string" },
          "status": { "enum": ["Planned", "Running", "Rejected", "Promoted", "Inconclusive"] },
          "preregistered_thresholds": { "type": "object" },
          "workload_results": { "type": "array" },
          "maintenance_review": { "type": "string" }
        }
      }
    }
  }
}
