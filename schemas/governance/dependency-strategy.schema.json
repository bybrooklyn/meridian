{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meridian strategic dependency registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "records"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "0.5"},
    "records": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "purpose", "license", "current_use", "boundary", "replacement_difficulty", "strategic_importance", "performance_relevance", "maintenance_risk", "compatibility", "test_requirements", "category", "planned_alternative", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^DEP-[A-Z]+-[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 5},
          "license": {"type": "string", "minLength": 1},
          "current_use": {"type": "string", "minLength": 5},
          "boundary": {"type": "string", "minLength": 5},
          "replacement_difficulty": {"enum": ["Low", "Medium", "High", "Extreme"]},
          "strategic_importance": {"enum": ["Low", "Medium", "High", "Critical"]},
          "performance_relevance": {"enum": ["Low", "Medium", "High", "Critical"]},
          "maintenance_risk": {"enum": ["Low", "Medium", "High", "Extreme"]},
          "compatibility": {"type": "string", "minLength": 5},
          "test_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "category": {"enum": ["InternalizeEarly", "InternalizeEventually", "WrapIndefinitelyUnlessNecessary"]},
          "planned_alternative": {"type": "string", "minLength": 3},
          "status": {"enum": ["Adopted", "Research", "ReplacementCandidate", "Retired"]}
        }
      }
    }
  }
}
