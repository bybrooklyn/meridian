{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meridian Marquee policy registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "records"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "0.5"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["program", "status", "capture_policy", "publishing_policy", "website_generation", "service_integrations", "release_ready_approval", "source_classes", "approval_invalidation", "ai"],
        "properties": {
          "program": {"const": "PRG-PRM-001"},
          "status": {"const": "Deferred"},
          "capture_policy": {"const": "ManualImportOnly"},
          "publishing_policy": {"const": "ExportOnly"},
          "website_generation": {"const": false},
          "service_integrations": {"const": false},
          "release_ready_approval": {"const": "ExplicitHuman"},
          "source_classes": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"enum": ["GameplayCapture", "StagedEngineRender", "Composite", "ExternalArt", "LicensedStock", "LogoBrandAsset", "Audio", "AuthoredCopy"]}
          },
          "approval_invalidation": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {"enum": ["Source", "SourceHash", "Claim", "BuildId", "Template", "Locale", "ExportProfile", "AiSuggestion", "ToolVersion", "Approval", "Font", "TransformRecipe"]}
          },
          "ai": {
            "type": "object",
            "additionalProperties": false,
            "required": ["optional", "cloud_opt_in", "exact_data_disclosure", "may_generate_text", "may_analyze_media", "may_generate_image", "may_generate_video", "may_generate_voice", "may_generate_music", "may_generate_sound", "may_modify_media", "suggestions_authoritative", "human_review_required", "zero_cost_when_disabled"],
            "properties": {
              "optional": {"const": true},
              "cloud_opt_in": {"const": true},
              "exact_data_disclosure": {"const": true},
              "may_generate_text": {"const": true},
              "may_analyze_media": {"const": true},
              "may_generate_image": {"const": false},
              "may_generate_video": {"const": false},
              "may_generate_voice": {"const": false},
              "may_generate_music": {"const": false},
              "may_generate_sound": {"const": false},
              "may_modify_media": {"const": false},
              "suggestions_authoritative": {"const": false},
              "human_review_required": {"const": true},
              "zero_cost_when_disabled": {"const": true}
            }
          }
        }
      }
    }
  }
}
