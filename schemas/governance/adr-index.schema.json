{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meridian ADR index",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "records"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "0.5"},
    "records": {
      "type": "array",
      "minItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^ADR-[0-9]{4}$"},
          "status": {"enum": ["Proposed", "Adopted", "Superseded", "Rejected", "Deprecated"]},
          "path": {"type": "string", "pattern": "^docs/architecture/decisions/ADR-[0-9]{4}-.+\\.md$"}
        }
      }
    }
  }
}
