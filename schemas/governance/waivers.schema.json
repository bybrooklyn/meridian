{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meridian waivers",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const":"0.5" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "owner",
          "approver",
          "approval_role",
          "expires",
          "blocked_milestone",
          "remediation_package",
          "reason",
          "risk"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^WVR-[A-Z]+-[0-9]{3}$" },
          "status": { "enum": ["Active", "Expired", "Closed", "Rejected"] },
          "owner": { "type": "string", "minLength": 1 },
          "approver": { "type": "string", "minLength": 1 },
          "approval_role": { "enum": ["Validation", "Release"] },
          "expires": { "type": "string", "format": "date" },
          "blocked_milestone": { "type": "string", "pattern": "^MS-(0[0-9]|10)$" },
          "remediation_package": { "type": "string", "pattern": "^WP-[A-Z]+-[0-9]{3}$" },
          "reason": { "type": "string", "minLength": 10 },
          "risk": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
