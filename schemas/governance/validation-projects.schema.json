{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meridian validation project registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "records"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "0.5"},
    "records": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "authority", "status", "calibration", "domains", "proving_requirements", "corpus_policy"],
        "properties": {
          "id": {"type": "string", "pattern": "^VAL-[A-Z]+-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "authority": {"enum": ["PublicGeneric", "PrivateConsumer"]},
          "status": {"const": "DefinitionOnly"},
          "calibration": {"const": "Uncalibrated"},
          "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "proving_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{3}$"}},
          "corpus_policy": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
