{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meridian UI workspace contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "shell", "records"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "1.0"},
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application_row", "workspace_row", "status_row", "rows_merge", "narrow_strategy"],
      "properties": {
        "application_row": {"const": 44},
        "workspace_row": {"const": 36},
        "status_row": {"const": 24},
        "rows_merge": {"const": false},
        "narrow_strategy": {"const": "compress-utilities-and-controlled-workspace-overflow"}
      }
    },
    "records": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability_owner", "package_dependencies", "regions", "activation", "unavailable_policy"],
        "properties": {
          "id": {"type": "string", "pattern": "^workspace\\.[a-z0-9.-]+$"},
          "capability_owner": {"type": "string", "pattern": "^[A-Z]+$"},
          "package_dependencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^WP-[A-Z]+-[0-9]{3}$"}},
          "regions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "role", "responsive_priority"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
                "role": {"type": "string", "minLength": 2},
                "default_size": {"type": "number", "minimum": 0},
                "responsive_priority": {"type": "integer", "minimum": 1, "maximum": 5}
              }
            }
          },
          "activation": {"enum": ["single", "contextual-then-focus", "remembered-focus"]},
          "unavailable_policy": {"const": "typed-diagnostic-no-simulated-capability"}
        }
      }
    }
  }
}
